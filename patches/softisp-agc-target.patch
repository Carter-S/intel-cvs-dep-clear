 static constexpr float kExposureSatisfactory = 0.2;
 
+/*
+ * Allow overriding the AGC brightness target at runtime via the
+ * SOFTISP_AGC_TARGET environment variable (same 0..kExposureBinsCount
+ * scale as kExposureOptimal; sane values 1.0 - 3.5, default 2.5).
+ * Local patch: upstream softISP has no exposure target control yet.
+ */
+static float exposureOptimal()
+{
+	static const float value = []() {
+		const char *env = std::getenv("SOFTISP_AGC_TARGET");
+		if (env) {
+			float v = std::atof(env);
+			if (v >= 0.5f && v <= 4.5f)
+				return v;
+		}
+		return kExposureOptimal;
+	}();
+	return value;
+}
+
